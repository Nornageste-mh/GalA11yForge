<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GalA11yForge.Adapters.Il2Cpp</RootNamespace>
    <AssemblyName>Forge.Adapters.Il2Cpp</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forge.Core\Forge.Core.csproj" />
    <ProjectReference Include="..\Forge.Detection\Forge.Detection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cecil 0.11.6 与 Unity Mono 适配器同版本；IL2CPP 的 interop 程序集是普通托管程序集，可直接只读扫描。 -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Adapters.Il2Cpp.Tests" />
  </ItemGroup>

</Project>
