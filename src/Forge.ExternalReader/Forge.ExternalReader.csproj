<Project Sdk="Microsoft.NET.Sdk">

  <!--
    R22 / task-40：万能层 v1 原型（外部读屏器）。
    只读附着：不注入、不改游戏目录；UIA/Win32 优先，Windows OCR 兜底（默认关）。

    说明：
      * TargetFramework 用 net8.0-windows10.0.19041.0 是为了拿到 CsWinRT 投影
        （Windows.Media.Ocr / Windows.Graphics.Imaging），否则 .NET 8 下没有
        System.Runtime.WindowsRuntime 那套 WinRT 支持。
      * UseWindowsForms 同时带来 System.Drawing.Common（截屏与 PNG 取证）。
      * FlaUI.UIA3 4.0.0（MIT）是唯一第三方运行时包；见 THIRD-PARTY-NOTICES.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      events 模式用托管的 System.Windows.Automation（UIAutomationClient.dll）。
      该程序集只随 WindowsDesktop 的 WPF 部分下发；UseWPF 只是把引用带进来，
      不引入新的运行时依赖（UseWindowsForms 已经要求 Microsoft.WindowsDesktop.App）。
      显式 <Reference Include="UIAutomationClient"/> 在 .NET 8 SDK 下解析不到（MSB3245）。
    -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Forge.ExternalReader</AssemblyName>
    <RootNamespace>GalA11yForge.ExternalReader</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- UseWPF 的隐式 using 集合不含 System.IO；补回来，保持原 WinForms 工程的可用性 -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
